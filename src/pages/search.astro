---
import Base from '../layouts/Base.astro';
import { BOOKS } from '../lib/content';
import { href } from '../lib/urls';
---
<Base title="Search" barTitle="Search" screen="search" kind="nahw" backHref={href()}>
  <main class="wrap narrow" data-index={href('search-index.json')}>
    <div class="search-field">
      <i class="ph ph-magnifying-glass"></i>
      <input class="input" type="search" dir="auto" placeholder="Search in Arabic or English" aria-label="Search lessons" autocomplete="off" data-q autofocus>
      <button class="btn btn-icon" type="button" aria-label="Clear" data-clear hidden><i class="ph ph-x-circle"></i></button>
    </div>
    <div class="search-tip"><i class="ph ph-info"></i>Vowel marks are ignored, so <span class="ar" lang="ar" dir="rtl">مَدَّ</span>, <span class="ar" lang="ar" dir="rtl">مُدّ</span> and <span class="ar" lang="ar" dir="rtl">مد</span> all match.</div>
    <div class="chips" style="gap:6px;margin-top:16px">
      <button class="filter" type="button" data-filter="all" aria-pressed="true"><span class="sq" style="background:var(--muted)"></span>All<span class="c" data-count="all"></span></button>
      {BOOKS.map((b) => (
        <button class={`filter k-${b.kind}`} type="button" data-filter={b.id} aria-pressed="false"><span class="sq"></span>{b.short}<span class="c" data-count={b.id}></span></button>
      ))}
    </div>
    <div class="result-count" data-result-count>Type to search all three books</div>
    <div class="results" data-results></div>
  </main>
</Base>
<script>
  import '../scripts/search';
</script>
